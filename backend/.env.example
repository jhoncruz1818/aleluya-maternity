# -----------------------------------------------------------------------------
# Copia a .env y rellena. Nunca subas .env a Git.
# -----------------------------------------------------------------------------

PORT=3001

# Local:
# DATABASE_URL="sqlserver://localhost:1433;database=tienda_ropa_mama;user=TU_USUARIO;password=TU_PASSWORD;encrypt=true;trustServerCertificate=true"
# Producción (Azure SQL): encrypt=true; normalmente SIN trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=tienda_ropa_mama;user=TU_USUARIO;password=TU_PASSWORD;encrypt=true;trustServerCertificate=true"

JWT_SECRET="cambia-este-secreto-por-uno-muy-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Openpay Perú — https://www.openpay.pe/
OPENPAY_MERCHANT_ID="tu_merchant_id"
OPENPAY_PRIVATE_KEY="sk_xxxxxxxx"
OPENPAY_PUBLIC_KEY="pk_xxxxxxxx"
# false = sandbox | true = producción
OPENPAY_PRODUCTION="false"
OPENPAY_WEBHOOK_USER=""
OPENPAY_WEBHOOK_PASSWORD=""

# Origen exacto del frontend (CORS). Local: http://localhost:3000
FRONTEND_URL="http://localhost:3000"

# URL pública del API SIN /api (para links de imágenes subidas detrás de proxy)
# Local: http://localhost:3001
# Prod: https://tu-api.ejemplo.com
PUBLIC_API_URL="http://localhost:3001"

# Dueño(s): pueden limpiar movimientos ya anulados del historial
OWNER_EMAILS="tu@correo.com"
