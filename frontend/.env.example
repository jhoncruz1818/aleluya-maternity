# Copia a .env.local (local) o configúralo en Vercel (producción).
# No subas .env.local a Git.

# Local: http://localhost:3001/api
# Prod:  https://tu-api.ejemplo.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# URL pública del storefront (sitemap, robots, JSON-LD)
# Local: http://localhost:3000
# Prod:  https://aleluya-maternity.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host del API (sin /api) para next/image con fotos subidas
# Local: localhost (puerto 3001 en next.config)
# Prod:  tu-api.ejemplo.com
NEXT_PUBLIC_API_HOST=localhost

# Openpay Perú (claves públicas del dashboard)
NEXT_PUBLIC_OPENPAY_MERCHANT_ID=tu_merchant_id
NEXT_PUBLIC_OPENPAY_PUBLIC_KEY=pk_xxxxxxxx
# true = sandbox | false = producción
NEXT_PUBLIC_OPENPAY_SANDBOX=true
